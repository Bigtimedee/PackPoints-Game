#!/usr/bin/env python3
"""Fails (exit 1) if any player surname from the dealable pool appears in the SEO kit.
Pool sources: (1) live /api/qa/sets/:id/dealable-cards when PACKPTS_QA_TOKEN is set (Eng/CI);
(2) every "player"/"playerName" in pool snapshots under --pool-dir (Design QA dumps; a superset incl. blocked cards).
Also fails on em/en dashes, 'coming soon', and $ or % in Points copy."""
import json, os, re, sys, glob, argparse, socket, time, urllib.request, urllib.error
ap=argparse.ArgumentParser(); ap.add_argument("--kit",default=os.path.join(os.path.dirname(__file__),"..","content"))
ap.add_argument("--pool-dir",default="/workspace/packpts-design"); ap.add_argument("--base",default="https://packpts.com")
a=ap.parse_args()
SUFFIX={"jr","jr.","sr","sr.","ii","iii","iv"}
names=set()
def collect(x):
    if isinstance(x,dict):
        for k in ("player","playerName","player_name"):
            if isinstance(x.get(k),str): names.add(x[k])
        for v in x.values(): collect(v)
    elif isinstance(x,list):
        for v in x: collect(v)
tok=os.environ.get("PACKPTS_QA_TOKEN"); live=0
RETRY_DELAYS=(5,15,30)
def fetch_json(req):
    """Live fetch with retry/backoff on 5xx, URLError and timeouts (a deploy blip
    must not turn main red). 4xx and bad JSON fail immediately."""
    for i,delay in enumerate(RETRY_DELAYS+(None,)):
        try:
            with urllib.request.urlopen(req,timeout=30) as resp: return json.load(resp)
        except urllib.error.HTTPError as e:
            if e.code<500 or delay is None: raise
            err=e
        except (urllib.error.URLError,socket.timeout,TimeoutError,ConnectionError) as e:
            if delay is None: raise
            err=e
        url=req if isinstance(req,str) else req.full_url
        print(f"retry {i+1}/{len(RETRY_DELAYS)} in {delay}s: {url}: {err}",flush=True); time.sleep(delay)
if tok:
    sets=fetch_json(a.base+"/api/sets")["sets"]
    for s in sets:
        try:
            r=urllib.request.Request(f"{a.base}/api/qa/sets/{s['id']}/dealable-cards?limit=2000",headers={"X-QA-Token":tok})
            collect(fetch_json(r)); live+=1
        except Exception as e: print("warn live",s["setName"],e)
for f in glob.glob(os.path.join(a.pool_dir,"**/*.json"),recursive=True):
    if os.path.abspath(f).startswith(os.path.abspath(a.kit)): continue
    try: collect(json.load(open(f)))
    except Exception: pass
sur=set()
for n in names:
    parts=[p for p in re.split(r"[\s/,&]+",n.strip()) if p and p.lower() not in SUFFIX]
    if parts and len(parts[-1])>=3: sur.add(parts[-1].strip(".").lower())
if len(sur)<200: print(f"FAIL: pool too small ({len(sur)} surnames)"); sys.exit(1)
fails=[]
for f in sorted(glob.glob(os.path.join(a.kit,"**/*"),recursive=True)):
    if not f.endswith((".json",".md",".html")) or "_live_sets_snapshot" in f: continue
    t=open(f,encoding="utf-8").read(); low=t.lower()
    if f.endswith(".html"):  # visible text + meta content + JSON-LD; skip JS/CSS
        import html as _h
        _v=[]
        def _w(x):
            if isinstance(x,dict): [_w(y) for y in x.values()]
            elif isinstance(x,list): [_w(y) for y in x]
            elif isinstance(x,str): _v.append(x)
        for blk in re.findall(r'<script type="application/ld\+json"[^>]*>(.*?)</script>',t,re.S):
            try: _w(json.loads(blk))
            except Exception: _v.append(blk)
        ld=" ".join(_v)
        meta=" ".join(re.findall(r'content="([^"]*)"',t))+" "+" ".join(re.findall(r'alt="([^"]*)"',t))
        body=re.sub(r"<script.*?</script>|<style.*?</style>|<!--.*?-->","",t,flags=re.S)
        low=_h.unescape(re.sub("<[^>]+>"," ",body)+" "+meta+" "+ld).lower(); t=low
    elif f.endswith(".json"):  # scan values only; schema.org keys like "price" are not copy
        vals=[]; 
        def v(x):
            if isinstance(x,dict): [v(y) for y in x.values()]
            elif isinstance(x,list): [v(y) for y in x]
            elif isinstance(x,str): vals.append(x)
        v(json.loads(t)); low=" ".join(vals).lower()
    for w in set(re.findall(r"[a-z][a-z'.-]+",low)):
        if w.strip(".'-") in sur: fails.append(f"{os.path.basename(f)}: surname '{w}'")
    if re.search("[\u2013\u2014]",t): fails.append(f"{os.path.basename(f)}: em/en dash")
    if "coming soon" in low: fails.append(f"{os.path.basename(f)}: coming soon")
# /points may state the 70% rebate split (Marketing AEO copy, 10/30). Any other $, %, percent, or dollars still fails.
REBATE_SPLIT_PHRASE="70%"
if os.path.exists(os.path.join(a.kit,"core-pages.json")):
    for p in json.load(open(os.path.join(a.kit,"core-pages.json")))["core"]:
        if p["path"]=="/points" and re.search(r"[$%]|\bpercent\b|\bdollars?\b",json.dumps(p).replace(REBATE_SPLIT_PHRASE,"")): fails.append("/points: money amount")
print(f"pool: {len(names)} names, {len(sur)} surnames (live sets fetched: {live})")
if fails: print("FAIL\n"+"\n".join(sorted(set(fails)))); sys.exit(1)
print("PASS: no pool surnames, dashes, 'coming soon' or Points money figures in kit")
